# model-router environment template
# Copy to .env and fill in the providers you use:   cp .env.template .env
# The library reads keys from the process environment (os.environ).
# Load with:  set -a; source .env; set +a    -- or --  python-dotenv / your process manager.
# Never commit .env.

# ── Classifier (Jev) — default backend: OpenRouter ──────────────────────────
# JevClassifier() routes to typesafe/jev-1.13 via OpenRouter.
# This key also hosts deepseek-4 chat in the default catalog.
OPENROUTER_API_KEY=
# Alternate Jev backends: JevClassifier(backend="gateway") / (backend="typesafe")
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=

# ── Chat providers (default catalog) ─────────────────────────────────────────
# gpt-6-luna, gpt-6.1-sol, gpt-6-astra; also default host for LLMClassifier
OPENAI_API_KEY=
# gemini-3.8-flash (via Google's OpenAI-compatible endpoint)
GEMINI_API_KEY=
# glm-5.3-flash, kimi-k3, deepseek-4
FIREWORKS_API_KEY=
# glm-5.3-flash, kimi-k3, deepseek-4
BASETEN_API_KEY=
# deepseek-4 (official API — usually cheapest host)
DEEPSEEK_API_KEY=

# ── Optional / extension providers (not in default catalog) ─────────────────
# Claude models via AnthropicProvider (add catalog entries to use)
ANTHROPIC_API_KEY=

# ── Optional overrides ───────────────────────────────────────────────────────
# Override any Jev backend's base URL (e.g. an OpenRouter-compatible proxy)
#JEV_GATEWAY_BASE_URL=
